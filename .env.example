SECRET_KEY=django-insecure-prod-key-change-this-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL default, falls back to SQLite if empty/not set)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=jobboard_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Settings
JWT_SECRET_KEY=jwt-secret-key-change-this-in-production-987654321
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Media & Storage
MEDIA_ROOT=media
MEDIA_URL=/media/
